---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { course, href } from '@/lib/site';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Resources" description="CS50 materials, C books, other courses, tools and setup guides for Introduction to Computer Science.">
  <div class="wrap py-14 md:py-20">
    <SectionHeading eyebrow="Resources" title="Everything worth your time" lede="CS50 is the backbone; the books and courses below are the second explanation when the first one does not click. Each week page links the parts that matter that week." />

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <a href={course.cs50.home} target="_blank" rel="noopener" class="card group flex flex-wrap items-center justify-between gap-4 p-5 hover:border-ink">
        <span>
          <span class="eyebrow">Primary source</span>
          <span class="mt-1 block font-semibold text-ink group-hover:text-brand">CS50x 2026 · Harvard University</span>
          <span class="block text-sm text-ink-3">Lectures, notes, slides, source code, problem sets. You are enrolled on edX; the YouTube playlist is public.</span>
        </span>
        <span class="font-mono text-sm text-ink-3">cs50.harvard.edu ↗</span>
      </a>
      <a href={course.previousSite.url} target="_blank" rel="noopener" class="card group flex flex-wrap items-center justify-between gap-4 p-5 hover:border-ink">
        <span>
          <span class="eyebrow">Archive</span>
          <span class="mt-1 block font-semibold text-ink group-hover:text-brand">{course.previousSite.title}</span>
          <span class="block text-sm text-ink-3">Last year's lectures, slides, C lab assignments and exams.</span>
        </span>
        <span class="font-mono text-sm text-ink-3">notion ↗</span>
      </a>
    </div>

    <section class="mt-14">
      <h2 class="display text-3xl text-ink">Guides</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {guides.map((g) => (
          <li><a href={href(`/guides/${g.id}`)} class="card block h-full p-5 hover:border-ink"><span class="font-semibold text-ink">{g.data.title}</span><span class="mt-1 block text-sm text-ink-2">{g.data.description}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="mt-14 grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="display text-3xl text-ink">Books</h2>
        <ul class="mt-5 divide-y divide-line rounded-2xl border border-line bg-card">
          {course.books.map((b) => (
            <li class="p-4">
              {'url' in b && b.url ? <a href={b.url} target="_blank" rel="noopener" class="font-semibold text-ink hover:text-brand">{b.title} ↗</a> : <span class="font-semibold text-ink">{b.title}</span>}
              <span class="block text-sm text-ink-2">{b.author}</span>
              {b.note && <span class="mt-0.5 block text-xs text-ink-3">{b.note}</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="display text-3xl text-ink">Other great courses</h2>
        <ul class="mt-5 divide-y divide-line rounded-2xl border border-line bg-card">
          {course.courses.map((c) => (
            <li class="p-4">
              <a href={c.url} target="_blank" rel="noopener" class="font-semibold text-ink hover:text-brand">{c.title} ↗</a>
              <span class="block text-sm text-ink-2">{c.org}</span>
              {c.note && <span class="mt-0.5 block text-xs text-ink-3">{c.note}</span>}
            </li>
          ))}
        </ul>
        <h2 class="display mt-12 text-3xl text-ink">Tools</h2>
        <ul class="mt-5 divide-y divide-line rounded-2xl border border-line bg-card">
          {course.tools.map((c) => (
            <li class="p-4">
              <a href={c.url} target="_blank" rel="noopener" class="font-semibold text-ink hover:text-brand">{c.title} ↗</a>
              <span class="block text-sm text-ink-2">{c.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
