---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import cardsData from '@content/data/project-cards.json';
import { href, weekHref, scheduleOf, formatDate, course } from '@/lib/site';

const { salt, iter, cards } = cardsData;
const acceptUrl = `${course.classroom.web}/${course.classroom.org}/${course.classroom.slug}/assignments/project/accept`;

const milestones = [
  { w: 2, t: 'Framework published', d: 'This page: what the project is, how it is assigned, the milestones and the rubric.' },
  { w: 5, t: 'Your project, your repository', d: 'Type your student number above to see your project. Accept the project repository on Classroom 50, write a one-paragraph plan and a task list in the README, make the first commit.' },
  { w: 11, t: 'Prototype check-in', d: 'The minimum scope runs end to end. Tag the repository m3-prototype. Five-minute check in the lab: you show it, we look at the commit history together.' },
  { w: 14, t: 'Project workshop', d: 'Lab time devoted to your project: polish, tests, README, rehearse the demo with one other student.' },
  { w: 15, t: 'Demo day', d: 'Five-minute live demo from your repository, followed by two or three questions, and a tagged v1.0 release.' },
];
const themes = [
  { t: 'Text and ciphers', w: [3, 4], d: 'Strings, loops and arrays in C. Small programs with a big history.' },
  { t: 'Algorithms', w: [5], d: 'Searching, sorting and problem solving, with running time you can measure.' },
  { t: 'Memory, files and images', w: [6], d: 'Bytes, pointers and binary files. The most “under the hood” projects.' },
  { t: 'Data structures', w: [7], d: 'Linked lists, hash tables and tries. Speed and memory trade-offs you can feel.' },
  { t: 'Python, AI and data', w: [9, 10, 11], d: 'Higher-level languages and real data. Tools you will actually use.' },
  { t: 'The web', w: [12, 13], d: 'Things people can click. HTML, CSS and JavaScript, with an optional Python backend.' },
];
const rubric = [
  { k: 'Correctness and completeness', p: 30, d: 'The minimum scope works without crashes on normal and edge inputs. Advanced scope earns the top of the range.' },
  { k: 'Code quality and tests', p: 20, d: 'Readable names, small functions, comments where they help, no memory leaks (C), and a few tests or a check script.' },
  { k: 'Demo and explanation', p: 20, d: 'You can explain every part of your code, why you built it that way, and answer questions about it.' },
  { k: 'README and report', p: 15, d: 'A README that lets someone run it in five minutes, and a two-page report (docs/REPORT.md): problem, design, results, what you learned, limitations, sources.' },
  { k: 'Process', p: 15, d: 'Steady commit history from week 5 on (at least one meaningful commit most weeks), milestones on time, tagged releases. One giant final push scores zero here.' },
];
const DIFF = ['', 'approachable', 'solid', 'ambitious'];
---
<BaseLayout title="Semester project" description="The Introduction to Computer Science semester project: 15% of the final grade, your personal project card, milestones, commit tracking and rubric.">
  <header class="relative overflow-hidden border-b border-line">
    <div class="grid-paper grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative py-14 md:py-20">
      <p class="eyebrow">Semester project · 15% of the final grade</p>
      <h1 class="display mt-3 max-w-4xl text-5xl leading-[1] text-ink md:text-7xl">Build something <span class="text-brand">real</span>, one commit at a time.</h1>
      <p class="lede mt-6 max-w-2xl">
        Every student has a personal project: a small but complete program, sized for one person and ten weeks, built in your own GitHub repository and demoed live on the last Monday.
        Most projects are in C; some use Python or the web.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#find" class="btn-primary">Find my project ↓</a>
        <a href="#timeline" class="btn-ghost">Timeline</a>
        <a href="#rules" class="btn-ghost">Rules and rubric</a>
      </div>
    </div>
  </header>

  <!-- FIND MY PROJECT -->
  <section id="find" class="wrap scroll-mt-20 py-16">
    <div class="rounded-2xl border border-line bg-ink p-6 text-paper shadow-lift md:p-8">
      <p class="eyebrow !text-paper/60">Find my project</p>
      <h2 class="display mt-2 text-3xl md:text-4xl">Type your student number</h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-paper/75">
        Your number is not sent anywhere. Each card is encrypted with a key derived from its owner's student number; your browser derives the same key and can open only your card.
        The page source contains nothing but ciphertext, so nobody can read another student's project.
      </p>
      <form id="find-form" class="mt-5 flex flex-col gap-3 sm:flex-row" autocomplete="off">
        <label class="sr-only" for="student-no">Student number</label>
        <input id="student-no" name="student-no" inputmode="numeric" pattern="[0-9]*" placeholder="e.g. 2505430xx" maxlength="12"
               class="flex-1 rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 font-mono text-base text-paper placeholder:text-paper/35 focus:border-accent focus:outline-none" />
        <button type="submit" class="btn-accent justify-center">Show my project</button>
      </form>
      <p id="find-result" class="mt-3 min-h-5 text-sm text-paper/75" aria-live="polite"></p>
    </div>

    <p id="card-empty" class="mt-6 rounded-xl border border-dashed border-line-2 p-6 text-center text-sm text-ink-3">No project shown yet. Type your student number above.</p>
    <ol class="mt-6 space-y-5">
      {cards.map((c) => <li id={`card-${c.id}`} class="project-card hidden" data-iv={c.iv} data-ct={c.ct}></li>)}
    </ol>
    <template id="card-template">
      <div class="rounded-2xl border border-accent bg-card p-6 shadow-soft ring-4 ring-accent/15 md:p-8">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="font-mono font-semibold text-brand" data-f="code"></span>
          <span class="rounded bg-paper-2 px-1.5 py-0.5 font-mono text-ink-2" data-f="theme"></span>
          <span class="rounded bg-paper-2 px-1.5 py-0.5 font-mono text-ink-2" data-f="lang"></span>
          <span class="font-mono text-ink-3" data-f="difficulty"></span>
          <span class="ml-auto font-mono text-ink-3" data-f="student"></span>
        </div>
        <h3 class="display mt-3 text-3xl text-ink" data-f="title"></h3>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2" data-f="summary"></p>
        <p class="mt-3 flex flex-wrap gap-1.5" data-f="core"></p>
        <dl class="mt-5 grid gap-4 border-t border-line pt-4 md:grid-cols-2">
          <div><dt class="eyebrow !text-true">Minimum scope (a passing project)</dt><dd class="mt-1 text-[15px] leading-relaxed text-ink-2" data-f="min"></dd></div>
          <div><dt class="eyebrow !text-accent">Advanced scope (a top project)</dt><dd class="mt-1 text-[15px] leading-relaxed text-ink-2" data-f="advanced"></dd></div>
        </dl>
        <p class="mt-3 hidden rounded-lg border border-line bg-paper-2 px-3 py-2 text-sm text-ink" data-f="variant"></p>
        <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-line pt-4">
          <a data-f="accept" target="_blank" rel="noopener" class="btn-primary !text-xs">Accept the project repository on Classroom 50 ↗</a>
          <span class="font-mono text-xs text-ink-3">→ <span data-f="repo"></span></span>
        </div>
        <p class="mt-3 text-sm text-ink-2">Builds on <span data-f="weeks"></span>. Your first commit: the README's plan paragraph and task list, this week.</p>
      </div>
    </template>
  </section>

  <section class="wrap pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card p-6">
        <p class="eyebrow">What counts</p>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">The project is 15% of your <strong class="text-ink">final</strong> grade (the other 85% is the final exam). The final is 60% of the course, so the project is 9% of your overall grade, and the single best line on your CV from this course.</p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">How it was assigned</p>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">Projects were drawn at random from a bank of twenty across the six themes below, in <strong class="text-ink">week 5 ({formatDate(scheduleOf(5)?.date, true)})</strong>. Each has a <strong class="text-ink">minimum scope</strong> and an <strong class="text-ink">advanced scope</strong>. Two projects were given to two students, with different advanced scopes.</p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Where you work</p>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">In a private repository created by Classroom 50 from a starter (README skeleton, report template, Makefile, devcontainer), with the same Codespaces workflow as the <a class="link" href={href('/labs')}>labs</a>. Your commit history is part of the grade, so commit small and often.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-paper-2/50">
    <div class="wrap py-16">
      <SectionHeading eyebrow="Themes" title="Six themes, one per module" lede="Every project sits in one of these themes and builds on the weeks listed. If your theme's weeks are still ahead, start with the parts you already know and read ahead on the week pages." />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {themes.map((t) => (
          <li class="card p-5">
            <p class="font-mono text-xs text-ink-3">builds on {t.w.map((w) => `week ${w}`).join(', ')}</p>
            <h3 class="mt-2 text-lg font-semibold text-ink">{t.t}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-2">{t.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="timeline" class="wrap scroll-mt-20 py-16">
    <SectionHeading eyebrow="Timeline" title="Five milestones" lede="Dates are Mondays. Each milestone is checked in the lab or by looking at your repository." />
    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {milestones.map((m, i) => (
        <li class="card relative p-6">
          <p class="font-mono text-xs text-accent">M{i}</p>
          <h3 class="mt-2 text-lg font-semibold text-ink">{m.t}</h3>
          <p class="mt-1 font-mono text-xs text-ink-3"><a href={weekHref(m.w)} class="hover:text-brand">week {m.w}</a> · {formatDate(scheduleOf(m.w)?.date)}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-2">{m.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="rules" class="wrap scroll-mt-20 grid gap-12 border-t border-line py-16 md:grid-cols-[1.2fr_1fr]">
    <div>
      <SectionHeading eyebrow="Rubric" title="How it is graded" />
      <ul class="mt-8 space-y-3">
        {rubric.map((r) => (
          <li class="card grid grid-cols-[4rem_1fr] items-start gap-4 p-5">
            <span class="display text-4xl leading-none text-ink">{r.p}</span>
            <span><span class="block font-semibold text-ink">{r.k}</span><span class="mt-1 block text-sm text-ink-2">{r.d}</span></span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <SectionHeading eyebrow="Commit tracking" title="How process is measured" />
      <ul class="mt-8 space-y-4 text-[15px] leading-relaxed text-ink-2">
        <li class="border-l-2 border-line-2 pl-4"><strong class="text-ink">Weekly commits.</strong> From week 5 to week 15, at least one commit that changes real code or documentation most weeks. Commit messages say what changed (“add blur filter”, not “update”).</li>
        <li class="border-l-2 border-line-2 pl-4"><strong class="text-ink">Milestone tags.</strong> Tag <code class="font-mono text-sm">m3-prototype</code> by week 11 and <code class="font-mono text-sm">v1.0</code> before demo day. Tags are how the instructor finds the version you want graded.</li>
        <li class="border-l-2 border-line-2 pl-4"><strong class="text-ink">Task list in the README.</strong> The starter README has a checklist; tick items as you go. It doubles as your progress report.</li>
        <li class="border-l-2 border-line-2 pl-4"><strong class="text-ink">Deliverables.</strong> The repository (code, tests, README with build, run and an example run), the two-page report in <code class="font-mono text-sm">docs/REPORT.md</code>, and the five-minute live demo.</li>
      </ul>
      <aside class="callout callout-warn mt-8">
        <p class="callout-title">AI tools and integrity</p>
        <p>You may use AI assistants and the CS50 duck. You are graded on what <em>you</em> understand: expect questions about any line of your code. Cite tools, libraries and sources in the README. Copying another student's project is an integrity violation for both students.</p>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ salt, iter, acceptUrl }}>
    (() => {
      const form = document.getElementById('find-form');
      const input = document.getElementById('student-no');
      const out = document.getElementById('find-result');
      const empty = document.getElementById('card-empty');
      const tpl = document.getElementById('card-template');
      const cards = Array.from(document.querySelectorAll('.project-card'));
      const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
      const DIFF = ['', '★☆☆ approachable', '★★☆ solid', '★★★ ambitious'];
      const reset = () => { cards.forEach((c) => { c.classList.add('hidden'); c.innerHTML = ''; }); empty.classList.remove('hidden'); };

      async function deriveKey(no) {
        const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(no), 'PBKDF2', false, ['deriveKey']);
        return crypto.subtle.deriveKey({ name: 'PBKDF2', salt: new TextEncoder().encode(salt), iterations: iter, hash: 'SHA-256' },
          base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
      }
      async function tryOpen(key, card) {
        try {
          const buf = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(card.dataset.iv) }, key, b64(card.dataset.ct));
          return JSON.parse(new TextDecoder().decode(buf));
        } catch { return null; }
      }
      function render(card, p) {
        const node = tpl.content.cloneNode(true);
        for (const el of node.querySelectorAll('[data-f]')) {
          const f = el.dataset.f;
          if (f === 'core') { p.core.forEach((t) => { const s = document.createElement('span'); s.className = 'rounded bg-paper-2 px-1.5 py-0.5 font-mono text-[11px] text-ink-2'; s.textContent = t; el.appendChild(s); }); }
          else if (f === 'weeks') { el.textContent = p.weeks.map((w) => 'week ' + w).join(', '); }
          else if (f === 'difficulty') { el.textContent = DIFF[p.difficulty] || ''; }
          else if (f === 'variant') { if (p.variant) { el.textContent = 'Your variant: ' + p.variant; el.classList.remove('hidden'); } }
          else if (f === 'accept') { el.href = acceptUrl; }
          else if (f === 'student') { el.textContent = p.student + ' · @' + p.github; }
          else el.textContent = p[f] ?? '';
        }
        card.innerHTML = ''; card.appendChild(node); card.classList.remove('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const no = input.value.replace(/\D/g, '');
        reset();
        if (!no) { out.textContent = 'Please type your student number.'; return; }
        if (!window.isSecureContext || !crypto.subtle) { out.textContent = 'This browser cannot decrypt the card; use a current browser over https.'; return; }
        out.textContent = 'Opening your card…';
        const key = await deriveKey(no);
        for (const card of cards) {
          const p = await tryOpen(key, card);
          if (p) {
            render(card, p); empty.classList.add('hidden');
            out.textContent = `Your project: ${p.code} · ${p.title}. The card is below.`;
            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }
        }
        out.textContent = 'No project matches this number. Check the number, or email the instructor.';
      });
      input.addEventListener('input', () => { if (!input.value) { reset(); out.textContent = ''; } });
    })();
  </script>
</BaseLayout>
