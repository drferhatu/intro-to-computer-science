---
/**
 * Interactive "everything is bits" widget.
 * Left: type text → each character as ASCII code and 8 bits.
 * Right: click the 8 bits of one byte → decimal, hex, and the character it encodes.
 * Pure client-side JS, no dependencies. Used on the home page and in week 2.
 */
interface Props { initial?: string; id?: string; compact?: boolean; }
const { initial = 'CS', id = 'bits', compact = false } = Astro.props;
---
<div class:list={['bitplay overflow-hidden rounded-2xl border border-line-2 bg-card shadow-lift', compact && 'bitplay-compact']} data-bitplay id={id}>
  <div class="flex items-center justify-between border-b border-line bg-paper-2 px-4 py-2">
    <span class="font-mono text-[11px] font-medium text-ink-3">&gt;_ everything is bits</span>
    <span class="font-mono text-[11px] text-ink-3"><span class="bit bit-1 !size-4 !text-[10px]">1</span> = on <span class="ml-2 bit bit-0 !size-4 !text-[10px]">0</span> = off</span>
  </div>
  <div class="grid gap-6 p-4 sm:p-5 md:grid-cols-[1.1fr_0.9fr]">
    <div>
      <label class="eyebrow" for={`${id}-text`}>Type something (letters, digits, emoji)</label>
      <input id={`${id}-text`} data-text type="text" value={initial} maxlength="12" autocomplete="off" spellcheck="false"
        class="mt-2 w-full rounded-lg border border-line-2 bg-paper px-3 py-2 font-mono text-lg text-ink outline-none focus:border-brand" />
      <div data-chars class="mt-3 space-y-1.5"></div>
      <p data-total class="mt-3 font-mono text-[11px] text-ink-3"></p>
    </div>
    <div>
      <p class="eyebrow">Click the bits of one byte</p>
      <div data-byte class="mt-2 flex flex-wrap gap-1.5"></div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div class="rounded-lg border border-line bg-paper p-2"><p class="eyebrow !text-[9px]">decimal</p><p data-dec class="font-mono text-xl text-ink">0</p></div>
        <div class="rounded-lg border border-line bg-paper p-2"><p class="eyebrow !text-[9px]">hex</p><p data-hex class="font-mono text-xl text-ink">0x00</p></div>
        <div class="rounded-lg border border-line bg-paper p-2"><p class="eyebrow !text-[9px]">ASCII</p><p data-chr class="font-mono text-xl text-ink">·</p></div>
      </div>
      <p data-hint class="mt-3 text-xs leading-relaxed text-ink-3">Place values from the left: 128 64 32 16 8 4 2 1. Turn on 64 + 8 + 1 and you get 73, which ASCII calls <span class="font-mono">I</span>.</p>
    </div>
  </div>
</div>

<script>
  function setup(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-text]')!;
    const chars = root.querySelector<HTMLElement>('[data-chars]')!;
    const total = root.querySelector<HTMLElement>('[data-total]')!;
    const byteEl = root.querySelector<HTMLElement>('[data-byte]')!;
    const dec = root.querySelector<HTMLElement>('[data-dec]')!;
    const hex = root.querySelector<HTMLElement>('[data-hex]')!;
    const chr = root.querySelector<HTMLElement>('[data-chr]')!;
    const enc = new TextEncoder();

    const bitsOf = (n: number, w = 8) => n.toString(2).padStart(w, '0');
    const chip = (b: string) => `<span class="bit bit-${b} !size-[18px] !rounded !text-[10px]">${b}</span>`;

    function renderText() {
      const text = input.value;
      const glyphs = Array.from(text);
      let bytes = 0;
      chars.innerHTML = glyphs.slice(0, 12).map((g) => {
        const bs = Array.from(enc.encode(g));
        bytes += bs.length;
        const cp = g.codePointAt(0)!;
        const label = bs.length === 1 ? `${cp}` : `U+${cp.toString(16).toUpperCase()} · ${bs.length} bytes`;
        return `<div class="flex flex-wrap items-center gap-2 rounded-lg border border-line bg-paper px-2.5 py-1.5">
          <span class="grid size-7 place-items-center rounded-md bg-ink font-mono text-sm text-paper">${g === ' ' ? '␣' : g}</span>
          <span class="w-24 shrink-0 font-mono text-[11px] text-ink-3">${label}</span>
          <span class="flex flex-wrap gap-[3px]">${bs.map((b) => bitsOf(b).split('').map(chip).join('')).join('<span class="w-1.5"></span>')}</span>
        </div>`;
      }).join('');
      total.textContent = glyphs.length ? `${glyphs.length} character${glyphs.length > 1 ? 's' : ''} → ${bytes} byte${bytes > 1 ? 's' : ''} → ${bytes * 8} bits` : 'Type to see the bits.';
    }

    let value = 73; // "I"
    function renderByte() {
      byteEl.innerHTML = bitsOf(value).split('').map((b, i) =>
        `<button type="button" data-i="${i}" aria-label="bit ${7 - i}, value ${2 ** (7 - i)}" class="bit bit-${b} !size-9 !text-base cursor-pointer hover:ring-2 hover:ring-brand/40"><span>${b}</span></button>`).join('');
      dec.textContent = String(value);
      hex.textContent = '0x' + value.toString(16).toUpperCase().padStart(2, '0');
      chr.textContent = value >= 32 && value < 127 ? String.fromCharCode(value) : value === 0 ? 'NUL' : value === 10 ? '\\n' : '·';
      byteEl.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        value ^= 1 << (7 - Number(b.dataset.i));
        renderByte();
      }));
    }

    input.addEventListener('input', renderText);
    renderText();
    renderByte();
  }
  document.querySelectorAll<HTMLElement>('[data-bitplay]').forEach(setup);
</script>
