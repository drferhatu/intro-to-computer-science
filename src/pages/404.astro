---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/site';
---
<BaseLayout title="Not found">
  <div class="wrap-narrow py-24 text-center">
    <p class="font-mono text-sm text-accent">404 · segmentation fault (core dumped)</p>
    <h1 class="display mt-3 text-6xl text-ink">This address points nowhere.</h1>
    <p class="mt-4 text-ink-2">You dereferenced a pointer that was never allocated. Week 6 explains why that hurts.</p>
    <a href={href('/')} class="btn-primary mt-8">Back home</a>
  </div>
</BaseLayout>
